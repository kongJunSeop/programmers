#include <iostream>
#include <cstdlib>
using namespace std;
template <typename N>
class Node {
public:
    Node(const N& data) : link_(nullptr), data_(data) {}
private:
    Node<N>* link_;
    N data_;
    friend class LinkedStack<N>;

};
template <typename T>
class LinkedStack {
public:
    LinkedStack() : top_(nullptr), count_(0) {}
    ~LinkedStack() { while (isEmpty()) pop(); }
    bool isEmpty(void) const { return top_ == nullptr; }
    int size(void) const { return count_; }
    void push(const T& data) {
        Node<T>* nnd = new Node<T>(data);
        nnd->link = top_;
        top_ = nnd;
        count_++;
    }
    void pop(void) {
        if (isEmpty()) return;
        Node<T>* tn = top_;
        top_ = top_->link_;
        delete tn;
        count_--;
    }
    T top(void) const { return top_->data_; }
    void printStack(void) const {
        if (isEmpty()) {
            cout << "NILL";
            return;
        }
        Node<T>* tn = top_;
        while (tn != nullptr) {
            cout << tn->data_; << " -->> ";
            tn = tn->link_;
        }
        cout << "NILL" << endl;
    }
private:
    Node<T>* top_;
    int count_;
};
int main(void) {
    LinkedStack<int> stack;
    int choice, num;
    while (1) {
        cout << "\n\n### 스택 구현: 단순연결리스트 ###\n\n";
        cout << "1) 데이터 삽입: push\n"
            << "2) 데이터 삭제: pop\n"
            << "3) 전체 출력\n"
            << "4) 프로그램 종료\n" << endl;
        cout << "메뉴 선택: ";
        cin >> choice;
        switch (choice) {
        case 1:
            while (1) {
                cout << "데이터 입력(종료: 0): ";
                cin >> num;

                if (num == 0) break;
                stack.push(num);
            }
            break;

        case 2:
            if (stack.isEmpty()) {
                cout << "데이터가 없습니다." << endl;
            }
            else {
                cout << "삭제된 데이터: " << stack.top() << endl;
                stack.pop();
            }
            break;

        case 3:
            stack.printStack();
            break;

        case 4:
            cout << "프로그램 종료!!!" << endl;
            return 0;

        default:
            cout << "\n\n잘못 선택하셨습니다!!!" << endl;
            break;
        }
        system("pause");
    }
    return 0;
}
